DATABASE_URL=

# ── Sentinel-1 위성 분석 (Google Earth Engine) ──
# 필요할 때만 앞의 #을 지우고 값을 넣으세요. (빈 값으로 두면 오류가 나요)
# 서비스 계정 JSON 키 파일 경로. 지정하지 않으면 config.json의 service_account_key_file을 씀
# Render: Secret Files에 키를 올리고 /etc/secrets/<파일 이름> 으로 지정
# EE_SERVICE_ACCOUNT_KEY_FILE=/etc/secrets/nonstop-514208-xxxx.json
# config.json을 다른 곳에 둘 때만 지정 (기본: 저장소 맨 위 config.json)
# SATELLITE_CONFIG_FILE=

# ── LoRaWAN 업링크 수신 (/lorawan/uplink) ──
# 정하면 게이트웨이 HTTP 연동 주소 뒤에 ?token=같은값 을 붙여야 저장됨 (아무나 데이터를 넣지 못하게)
# LORAWAN_WEBHOOK_TOKEN=
